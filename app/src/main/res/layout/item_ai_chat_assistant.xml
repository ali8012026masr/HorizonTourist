<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="6dp">

    <!-- Assistant Avatar Icon -->
    <ImageView
        android:id="@+id/ivAssistantIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="@string/title_ai_concierge"
        android:src="@drawable/ic_ai"
        app:tint="@color/tertiary" />

    <LinearLayout
        android:id="@+id/layoutAssistantContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Message Bubble -->
        <LinearLayout
            android:id="@+id/layoutBubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_bubble_other"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/tvAssistantMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Assistant message text"
                android:textColor="@color/on_surface"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Action: Filter Slots Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShowMatchingServices"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ai_action_filter_slots"
            android:textAllCaps="false"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:visibility="gone"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_search"
            app:iconTint="@color/primary"
            app:strokeColor="@color/primary" />

        <!-- Action: Bundle Preview Container -->
        <LinearLayout
            android:id="@+id/layoutBundle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvBundleTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/ai_bundle_title"
                android:textColor="@color/on_surface"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Loading indicator for bundle info -->
            <ProgressBar
                android:id="@+id/pbBundleLoading"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginVertical="6dp"
                android:visibility="gone" />

            <!-- Slot Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSlotPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_bundle_service_label"
                        android:textColor="@color/primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSlotTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        tools:text="Dhaka → Cox's Bazar"
                        android:textColor="@color/on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSlotPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        tools:text="BDT 1,200"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewSlot"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginTop="4dp"
                        android:paddingHorizontal="0dp"
                        android:text="@string/ai_action_view_service"
                        android:textAllCaps="false"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        app:icon="@drawable/ic_arrow_forward"
                        app:iconGravity="textEnd"
                        app:iconSize="14dp"
                        app:iconTint="@color/primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Guide Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGuidePreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_bundle_guide_label"
                        android:textColor="@color/secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvGuideName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        tools:text="Guide Name"
                        android:textColor="@color/on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvGuideRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        tools:text="★ 4.8 (12 reviews)"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvGuidePrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewGuide"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginTop="4dp"
                        android:paddingHorizontal="0dp"
                        android:text="@string/ai_action_view_guide"
                        android:textAllCaps="false"
                        android:textColor="@color/secondary"
                        android:textSize="12sp"
                        app:icon="@drawable/ic_arrow_forward"
                        app:iconGravity="textEnd"
                        app:iconSize="14dp"
                        app:iconTint="@color/secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Create Group Button for RECOMMEND_GROUP_BUNDLE -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreateGroup"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/ai_action_create_group"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:visibility="gone"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_groups"
                app:iconTint="@color/primary"
                app:strokeColor="@color/primary" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
